<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="mvz2mm.exe"
        Arguments=""
        InstallLocation="C:\Program Files\\mvz2mm">
    </Installer>
    <PackageInformation
        PackageName="mvz2mm"
        PackageDisplayName="mvz2mm"
        PublisherName="CN="
        PublisherDisplayName=""
        Version="0.1.0.0"
        PackageDescription="A mvz2 mod manager">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.github.sorrow-scarlet"
                Description="A mvz2 mod manager"
                DisplayName="mvz2mm"
                ExecutableName="mvz2mm.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>mvz2mm</DisplayName>
            <PublisherDisplayName></PublisherDisplayName>
            <Description>A mvz2 mod manager</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="mvz2mm.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
